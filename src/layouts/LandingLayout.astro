---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  variant?: string;
}

const { title, description, ogImage, variant } = Astro.props;
---

<BaseLayout {title} {description} {ogImage} {variant}>
  <main class="flex-1">
    <slot />
  </main>
  
  <!-- Footer -->
  <footer class="border-t bg-muted/50">

    <div class="container mx-auto px-6 py-12">
      <div class="grid gap-8 md:grid-cols-3 items-start">
        <!-- Brand -->
        <div>
          <h3 class="font-bold text-lg mb-3">Milka Collective</h3>
          <p class="text-sm text-muted-foreground mb-4">
            Brighton's premier lash extension and beauty salon. Over 95 5-Star Google verified reviews and 1000's of happy clients!
          </p>
        </div>
        
        <!-- Contact Info -->
        <div>
          <h3 class="font-bold text-lg mb-3">Contact Us</h3>
          <div class="space-y-2 text-sm text-muted-foreground">
            <p>📍 2/229 Bay St, Brighton VIC 3186</p>
            <p>📱 <a href="tel:0480095789" class="hover:text-foreground transition">0480095789</a></p>
            <p>✉️ <a href="mailto:hello@milkacollective.com.au" class="hover:text-foreground transition">hello@milkacollective.com.au</a></p>
          </div>
        </div>
        
        <!-- Hours -->
        <div>
          <h3 class="font-bold text-lg mb-3">Opening Hours</h3>
          <div class="space-y-1 text-sm text-muted-foreground">
            <p class="flex items-center gap-1">Mon-Thu: 10am-8pm</p>
            <p>Fri: 10am-5pm</p>
            <p>Sat: 10am-4pm</p>
            <p>Sun: Closed</p>
            <p class="mt-2 font-medium">By Appointment Only</p>
          </div>
        </div>
      </div>
      
      <div class="border-t mt-8 pt-8 text-center text-sm text-muted-foreground">
        <p>&copy; 2025 Milka Collective. All rights reserved.</p>
      </div>
    </div>
  </footer>
</BaseLayout>