---
import LandingLayout from '../layouts/LandingLayout.astro';
import TrustInfoBar from '../components/landing/TrustInfoBar.astro';
import { LuxuryHero } from '../components/beauty/LuxuryHero';
import { ServiceShowcase } from '../components/beauty/ServiceShowcase';
import { VideoShowcase } from '../components/beauty/VideoShowcase';
import { LuxuryTestimonials } from '../components/beauty/LuxuryTestimonials';
import { WhyChooseUs } from '../components/beauty/WhyChooseUs';
import { InstagramGallery } from '../components/beauty/InstagramGallery';
import { FloatingBookingButton } from '../components/beauty/FloatingBookingButton';
import { FAQ } from '../components/beauty/FAQ';
import { landingConfigs } from '../data/landing-configs';
import { bookingConfig, generateBookingUrl } from '../config/booking';
import type { Review } from '../lib/reviews';
import { LP_GOOGLE_REVIEW_TRUST } from '../data/lp-trust-copy';
import {
  normalizeApiReview,
  selectCarouselReviews,
  selectGridReviews,
  toCarouselTestimonials,
} from '../lib/reviews';

const config = landingConfigs.beauty;
const variant = 'beauty';

// API configuration - use environment variable for security
const apiKey = import.meta.env.REVIEW_API_KEY || "Tu7FbDX12fU1h0V23NyGAJWeGgE9JS";
const apiUrl = `https://apiv2.giveme5.ai/GetReviewDetail?key=${apiKey}&pageNumber=1&pageSize=60&showEmptyReview=false&minStars=5`;

let reviews: Review[] = [];

// Fetch the data on the server during build with retry logic
async function fetchReviewsWithRetry(url: string, maxRetries = 3, delay = 1000): Promise<Review[]> {
  for (let attempt = 1; attempt <= maxRetries; attempt++) {
    try {
      console.log(`Attempting to fetch reviews (attempt ${attempt}/${maxRetries})...`);
      
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 10000); // 10 second timeout
      
      const response = await fetch(url, { 
        signal: controller.signal,
        headers: {
          'User-Agent': 'Mozilla/5.0 (compatible; Astro-build)',
          'Accept': 'application/json',
        }
      });
      
      clearTimeout(timeoutId);
      
      if (!response.ok) {
        throw new Error(`API call failed with status: ${response.status} - ${response.statusText}`);
      }
      
      const data = await response.json();
      console.log('API response received successfully');
      
      // The reviews are nested inside data.data.reviews
      if (data && data.data && data.data.reviews) {
        const allReviews = (data.data.reviews as Review[]).map(normalizeApiReview);
        console.log(`Successfully loaded ${allReviews.length} reviews from API`);
        return allReviews;
      }
      
      return [];
    } catch (error) {
      console.error(`Attempt ${attempt} failed:`, error);
      
      if (attempt === maxRetries) {
        console.error("All retry attempts failed. Reviews will not be displayed.");
        return [];
      }
      
      // Wait before retrying (exponential backoff)
      await new Promise(resolve => setTimeout(resolve, delay * attempt));
    }
  }
  
  return [];
}

try {
  reviews = await fetchReviewsWithRetry(apiUrl);
} catch (error) {
  console.error("Failed to fetch review data after all retries:", error);
  reviews = [];
}

const carouselTestimonials = toCarouselTestimonials(selectCarouselReviews(reviews, 5));
const gridReviews = selectGridReviews(reviews, 15);

console.log(`Showing ${carouselTestimonials.length} carousel and ${gridReviews.length} grid lash-extension reviews`);

// Helper function to format date
function formatDate(dateString: string): string {
  try {
    return new Date(dateString).toLocaleDateString('en-AU', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  } catch {
    return 'Recently';
  }
}

// Helper function to generate star rating
function generateStars(rating: number): string {
  return '★'.repeat(Math.floor(rating)) + '☆'.repeat(5 - Math.floor(rating));
}

---

<LandingLayout 
  title={config.seo.title}
  description={config.seo.description}
  ogImage={config.seo.ogImage}
  variant={variant}
>
  <LuxuryHero client:load />
  
  <!-- Mobile-only info card underneath the fold -->
  <section class="py-8 section-alt border-t border-border block md:hidden">
    <div class="container mx-auto px-6">
      <div class="bg-card rounded-lg p-6 luxury-shadow border border-border max-w-md mx-auto">
        <div class="text-center">
          <p class="text-lg text-muted-foreground mb-6 leading-relaxed">
            Wakeup in your makeup every day with luxurious lash extensions crafted by Brighton's most experienced artists
          </p>
          
          <div class="space-y-3 text-sm text-muted-foreground">
            <div class="flex items-center justify-center gap-2">
              <span class="text-lg">⭐</span>
              <span class="font-medium text-foreground">{LP_GOOGLE_REVIEW_TRUST.overVerifiedLabel}</span>
            </div>
            
            <div class="border-t border-border pt-3">
              <div class="flex items-center justify-center gap-2 mb-2">
                <span class="text-lg">⏰</span>
                <span class="text-center">Mon-Thu 10am-8pm • Fri 10am-5pm • Sat 10am-4pm</span>
              </div>
              
              <div class="flex items-center justify-center gap-2">
                <span class="text-lg">📍</span>
                <span>2/229 Bay St, Brighton</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <ServiceShowcase client:idle />
  
  <VideoShowcase client:visible />
  
  <WhyChooseUs client:visible />
  
  <LuxuryTestimonials client:idle testimonials={carouselTestimonials} />
  
  <!-- Before/After Transformation Section -->
  <section class="py-16 section-alt border-t border-border relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
      <div class="text-center mb-10">
        <p class="eyebrow mb-4">The Transformation</p>
        <h2 class="text-foreground mb-4">Your Life Before & After</h2>
      </div>

      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-3 gap-6 items-center">
          <!-- Before -->
          <div class="text-center">
            <div class="pro-card p-6">
              <div class="text-4xl mb-3">😩</div>
              <h3 class="text-xl font-medium text-foreground mb-3">Your Morning Struggle</h3>
              <ul class="text-left text-muted-foreground space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <span class="text-accent">⏰</span>
                  <span>20+ minutes applying mascara</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-accent">😰</span>
                  <span>Avoiding photos</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-accent">💸</span>
                  <span>$100s on mascaras & false lashes</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-accent">😴</span>
                  <span>Waking up tired & unprepared</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Arrow -->
          <div class="text-center">
            <div class="text-4xl text-accent animate-pulse">→</div>
            <div class="text-sm text-muted-foreground mt-2 font-medium">Your transformation</div>
          </div>

          <!-- After -->
          <div class="text-center">
            <div class="pro-card p-6">
              <div class="text-4xl mb-3">😍</div>
              <h3 class="text-xl font-medium text-foreground mb-3">Your New Reality</h3>
              <ul class="text-left text-muted-foreground space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <span class="text-accent">⚡</span>
                  <span>2-minute morning routine</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-accent">📸</span>
                  <span>Camera-ready confidence 24/7</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-accent">💰</span>
                  <span>No more mascara expenses</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-accent">😊</span>
                  <span>Wake up beautiful & confident</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Transformation CTA -->
        <div class="text-center mt-12">
          <div class="pro-card p-8 max-w-2xl mx-auto">
            <h3 class="text-2xl font-semibold text-foreground mb-4">
              Ready to Make This Your Reality?
            </h3>
            <p class="text-muted-foreground mb-6">
              Over 500 Brighton women have already transformed their mornings. 
              Your turn to join them and never worry about mascara again.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a
                href={generateBookingUrl()}
                class="btn-luxury-primary text-center"
                onclick="triggerConfetti(); if (typeof window !== 'undefined' && window.dataLayer) { window.dataLayer.push({ event: 'booking_click', click_type: 'transformation_cta', service_type: 'full_set' }); }"
              >
                Book My Transformation
              </a>
              <a
                href="tel:0480095789"
                class="btn-luxury-outline text-center"
                onclick="if (typeof window !== 'undefined' && window.dataLayer) { window.dataLayer.push({ event: 'phone_click', click_type: 'transformation_cta' }); }"
              >
                Call 0480 095 789
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <InstagramGallery client:idle />
  
  <!-- Google Reviews Section -->
  <section class="py-24 section-base border-t border-border relative overflow-hidden">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <p class="eyebrow mb-4">Real Reviews</p>
        <h2 class="text-foreground mb-4">What Our Clients Say</h2>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
          Verified 5-star Google reviews from real clients — lash extensions at our Brighton studio.
        </p>
      </div>

      <!-- Reviews Grid -->
      {gridReviews && gridReviews.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto mb-12">
          {gridReviews.map((review, index) => (
            <article class="review-card group">
              <header class="card-header">
                <img 
                  src={review.profileImgUrl} 
                  alt={`Profile picture of ${review.reviewBy}`} 
                  class="profile-img"
                  loading="lazy"
                  referrerpolicy="no-referrer"
                  onerror="this.onerror=null;this.src='data:image/svg+xml;base64,';"
                />
                <div class="reviewer-info">
                  <h3 class="reviewer-name">{review.reviewBy}</h3>
                  <div class="star-rating" title={`Rated ${review.rating} out of 5 stars`}>
                    {generateStars(review.rating)}
                  </div>
                </div>
              </header>
              <blockquote class="review-body">
                <p>{review.reviewDetails}</p>
              </blockquote>
              <footer class="card-footer">
                <span class="review-source">Verified on {review.reviewSource}</span>
                <time class="review-date">{formatDate(review.date)}</time>
              </footer>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <style>
    .review-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 0.375rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
      transition: all 0.3s ease;
      height: 100%;
    }

    .review-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 25px rgba(0, 0, 0, 0.1), 0 10px 10px rgba(0, 0, 0, 0.04);
      border-color: var(--foreground);
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .profile-img {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      object-fit: cover;
      background-color: #f3f4f6;
      border: 2px solid var(--border);
    }

    .reviewer-info {
      flex: 1;
    }

    .reviewer-name {
      margin: 0 0 0.25rem 0;
      font-size: 1.1rem;
      font-weight: 600;
      color: #1f2937;
    }

    .star-rating {
      color: #fbbf24;
      font-size: 1rem;
      letter-spacing: 1px;
    }

    .review-body {
      margin: 0 0 1rem 0;
      flex-grow: 1;
      color: #4b5563;
      line-height: 1.6;
      font-style: italic;
    }

    .review-body p {
      margin: 0;
    }

    .card-footer {
      border-top: 1px solid var(--border);
      padding-top: 1rem;
      margin-top: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.875rem;
      color: #6b7280;
      gap: 1rem;
    }

    .review-source {
      font-weight: 500;
      color: var(--foreground);
    }

    .review-date {
      white-space: nowrap;
    }

    /* Mobile responsive adjustments */
    @media (max-width: 768px) {
      .card-footer {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
      
      .review-date {
        white-space: normal;
      }
    }
  </style>
  
  <!-- Help Choosing CTA -->
  <section class="py-16 section-alt border-t border-border">
    <div class="container mx-auto px-6">
      <div 
        class="pro-card max-w-3xl mx-auto text-center animate-fade-in-up"
        style="opacity: 0; animation: fadeInUp 0.6s ease-out forwards;"
      >
        <h3 class="text-2xl md:text-3xl font-semibold text-foreground mb-4">
          Need Help Choosing Your Perfect Lash Style?
        </h3>
        <p class="text-muted-foreground mb-6 text-lg">
          Call our lash experts now for free, personalised advice! We'll help you choose the perfect style for your eyes and lifestyle.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="tel:0480095789"
            class="btn-luxury-primary text-center"
            onclick="if (typeof window !== 'undefined' && window.dataLayer) { window.dataLayer.push({ event: 'phone_click', click_type: 'help_choosing' }); }"
          >
            Call Now: 0480 095 789
          </a>
          <a
            href={generateBookingUrl()}
            class="btn-luxury-outline text-center"
            onclick="triggerConfetti(); if (typeof window !== 'undefined' && window.dataLayer) { window.dataLayer.push({ event: 'booking_click', click_type: 'help_choosing', service_type: 'full_set' }); }"
          >
            Book Now
          </a>
        </div>
      </div>
    </div>
    
    <style>
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>
  </section>
  
  <FAQ faqs={config.faq || []} client:load />
  
  <!-- Final CTA Section -->
  <section class="py-24 premium-gradient relative overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-0 left-0 w-96 h-96 bg-primary rounded-full filter blur-3xl"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent rounded-full filter blur-3xl"></div>
    </div>
    
    <div class="container mx-auto px-6 text-center relative z-10 max-w-2xl">
      <h2 class="text-foreground mb-6">
        Ready to Love Your Lashes?
      </h2>
      
      <p class="text-xl text-muted-foreground mb-12">
        Wake up beautiful every day. Book your full set online — or call and we'll find the right style for you.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-stretch sm:items-center w-full max-w-md sm:max-w-none mx-auto">
        <a
          href={generateBookingUrl()}
          onclick="
            triggerConfettiFinalCTA();
            if (typeof window !== 'undefined' && window.dataLayer) {
              window.dataLayer.push({
                event: 'booking_click',
                click_type: 'final_cta',
                button_text: 'Book Your Appointment Now',
                service_type: 'full_set'
              });
            }
          "
          class="btn-luxury-primary normal-case tracking-normal text-[0.8125rem] sm:text-base whitespace-nowrap justify-center w-full sm:w-auto !px-3 sm:!px-8"
        >
          Book Your Appointment Now
        </a>
        
        <a
          href="tel:0480095789"
          onclick="
            triggerConfettiFinalCTA();
            if (typeof window !== 'undefined' && window.dataLayer) {
              window.dataLayer.push({
                event: 'phone_click',
                click_type: 'final_cta',
                phone_number: '0480095789'
              });
            }
          "
          class="btn-luxury-outline normal-case tracking-normal text-[0.8125rem] sm:text-base whitespace-nowrap justify-center w-full sm:w-auto !px-3 sm:!px-8"
        >
          Or Call&nbsp;0480&nbsp;095&nbsp;789
        </a>
      </div>
      
      <div class="mt-12 flex flex-wrap justify-center items-center gap-6 text-sm text-muted-foreground">
        <TrustInfoBar />
      </div>
    </div>
  </section>
  
  <FloatingBookingButton client:load />
</LandingLayout>

<script>
  // Optimized confetti loading - defer until first use with improved caching
  let confettiLoaded = false;
  let confetti;
  let confettiPromise;

  async function loadConfetti() {
    if (!confettiPromise) {
      // Use requestIdleCallback for better performance if available
      const loadModule = () => import('canvas-confetti').then(module => {
        confetti = module.default;
        confettiLoaded = true;
        return confetti;
      });

      if (window.requestIdleCallback) {
        confettiPromise = new Promise(resolve => {
          window.requestIdleCallback(() => {
            loadModule().then(resolve);
          });
        });
      } else {
        confettiPromise = loadModule();
      }
    }
    return confettiPromise;
  }

  // Simple confetti function for smaller CTAs - lazy loaded
  window.triggerConfetti = async function() {
    if (!confettiLoaded) {
      const confettiModule = await loadConfetti();
      confettiModule({
        particleCount: 100,
        spread: 70,
        origin: { y: 0.6 },
        colors: ['#0a0a0a', '#dcccb8', '#e3dad0', '#6e6862']
      });
    } else {
      confetti({
        particleCount: 100,
        spread: 70,
        origin: { y: 0.6 },
        colors: ['#0a0a0a', '#dcccb8', '#e3dad0', '#6e6862']
      });
    }
  };

  window.triggerConfettiFinalCTA = async function() {
    const confetti = await loadConfetti();
    
    // Create realistic confetti effect
    const count = 200;
    const defaults = {
      origin: { y: 0.7 }
    };

    function fire(particleRatio, opts) {
      confetti({
        ...defaults,
        ...opts,
        particleCount: Math.floor(count * particleRatio),
        colors: ['#0a0a0a', '#dcccb8', '#e3dad0', '#6e6862']
      });
    }

    // Multiple bursts for realistic effect
    fire(0.25, {
      spread: 26,
      startVelocity: 55,
    });

    fire(0.2, {
      spread: 60,
    });

    fire(0.35, {
      spread: 100,
      decay: 0.91,
      scalar: 0.8
    });

    fire(0.1, {
      spread: 120,
      startVelocity: 25,
      decay: 0.92,
      scalar: 1.2
    });

    fire(0.1, {
      spread: 120,
      startVelocity: 45,
    });
  };
</script>