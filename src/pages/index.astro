---
import LandingLayout from '../layouts/LandingLayout.astro';
import { LuxuryHero } from '../components/beauty/LuxuryHero';
import { ServiceShowcase } from '../components/beauty/ServiceShowcase';
import { VideoShowcase } from '../components/beauty/VideoShowcase';
import { LuxuryTestimonials } from '../components/beauty/LuxuryTestimonials';
import { WhyChooseUs } from '../components/beauty/WhyChooseUs';
import { InstagramGallery } from '../components/beauty/InstagramGallery';
import { FloatingBookingButton } from '../components/beauty/FloatingBookingButton';
import { FreeConsultationOffer } from '../components/beauty/FreeConsultationOffer';
import { FAQ } from '../components/beauty/FAQ';
import { landingConfigs } from '../data/landing-configs';

const config = landingConfigs.beauty;
const variant = 'beauty';

// Define the structure of a single review for TypeScript type safety
interface Review {
  profileImgUrl: string;
  reviewBy: string;
  reviewDetails: string;
  rating: number;
  date: string;
  reviewSource: string;
}

// API configuration - use environment variable for security
const apiKey = import.meta.env.REVIEW_API_KEY || "Tu7FbDX12fU1h0V23NyGAJWeGgE9JS";
const apiUrl = `https://dev-azurefunction20240603151829.azurewebsites.net/GetReviewDetail?key=${apiKey}&pageNumber=1&pageSize=20&showEmptyReview=false&minStars=4`;

let reviews: Review[] = [];

// Fetch the data on the server during build
try {
  const response = await fetch(apiUrl);
  if (!response.ok) {
    throw new Error(`API call failed with status: ${response.status}`);
  }
  const data = await response.json();
  
  // The reviews are nested inside data.data.reviews
  if (data && data.data && data.data.reviews) {
    // Filter for lash/beauty related reviews only (basic keyword filtering)
    const allReviews = data.data.reviews;
    const beautyKeywords = ['lash', 'lashes', 'beauty', 'beautiful', 'makeup', 'extensions', 'brow', 'eyelash'];
    const lashReviews = allReviews.filter(review => 
      beautyKeywords.some(keyword => 
        review.reviewDetails.toLowerCase().includes(keyword)
      )
    );
    
    // Use lash-related reviews if found, otherwise use all reviews
    reviews = (lashReviews.length > 0 ? lashReviews : allReviews).slice(0, 9);
  }
} catch (error) {
  console.error("Failed to fetch review data:", error);
  // If the API fails, reviews array remains empty and we show fallback
}

// Helper function to format date
function formatDate(dateString: string): string {
  try {
    return new Date(dateString).toLocaleDateString('en-AU', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  } catch {
    return 'Recently';
  }
}

// Helper function to generate star rating
function generateStars(rating: number): string {
  return '★'.repeat(Math.floor(rating)) + '☆'.repeat(5 - Math.floor(rating));
}

