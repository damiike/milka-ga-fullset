---
import LandingLayout from '../layouts/LandingLayout.astro';
import { LuxuryHero } from '../components/beauty/LuxuryHero';
import { ServiceShowcase } from '../components/beauty/ServiceShowcase';
import { VideoShowcase } from '../components/beauty/VideoShowcase';
import { LuxuryTestimonials } from '../components/beauty/LuxuryTestimonials';
import { WhyChooseUs } from '../components/beauty/WhyChooseUs';
import { InstagramGallery } from '../components/beauty/InstagramGallery';
import { FloatingBookingButton } from '../components/beauty/FloatingBookingButton';
import { FreeConsultationOffer } from '../components/beauty/FreeConsultationOffer';
import { FAQ } from '../components/beauty/FAQ';
import { landingConfigs } from '../data/landing-configs';

const config = landingConfigs.beauty;
const variant = 'beauty';

---

<LandingLayout 
  title={config.seo.title}
  description={config.seo.description}
  ogImage={config.seo.ogImage}
  variant={variant}
>
  <LuxuryHero client:load />
  
  <ServiceShowcase client:load />
  
  <VideoShowcase client:visible />
  
  <WhyChooseUs client:visible />
  
  <!-- Free Consultation Offer Section -->
  <section class="py-16 bg-white relative">
    <div class="container mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-light text-gray-900 mb-4">
          <span class="font-serif italic text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-rose-400">Free Consultation</span> with Every Full Set
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Book any full set and receive a complimentary consultation. Our experts will help you choose the perfect lash style tailored to your lifestyle and preferences.
        </p>
      </div>
      <FreeConsultationOffer client:visible />
    </div>
  </section>
  
  <LuxuryTestimonials client:visible />
  
  <InstagramGallery client:visible />
  
  <!-- Help Choosing CTA -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-6">
      <div 
        class="bg-white rounded-2xl p-8 shadow-xl border border-pink-100 max-w-3xl mx-auto text-center animate-fade-in-up"
        style="opacity: 0; animation: fadeInUp 0.6s ease-out forwards;"
      >
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-4">
          Need Help Choosing Your Perfect Lash Style?
        </h3>
        <p class="text-gray-600 mb-6 text-lg">
          Call our lash experts now for free, personalised advice! We'll help you choose the perfect style for your eyes and lifestyle.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="tel:0480095789"
            class="bg-gradient-to-r from-pink-500 to-rose-400 text-white px-8 py-3 rounded-full font-medium shadow-lg hover:shadow-xl transition-all text-center"
            onclick="if (typeof window !== 'undefined' && window.dataLayer) { window.dataLayer.push({ event: 'phone_click', click_type: 'help_choosing' }); }"
          >
            Call Now: 0480 095 789
          </a>
          <a
            href="https://www.fresha.com/a/milka-collective-brighton-melbourne-229-bay-street-m4vife5o/booking?menu=true"
            class="bg-white text-gray-800 px-8 py-3 rounded-full font-medium shadow-lg border border-gray-200 hover:bg-gray-50 transition-all text-center"
            onclick="if (typeof window !== 'undefined' && window.dataLayer) { window.dataLayer.push({ event: 'booking_click', click_type: 'help_choosing' }); }"
          >
            Book a Consultation
          </a>
        </div>
      </div>
    </div>
    
    <style>
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>
  </section>
  
  <FAQ faqs={config.faq || []} client:visible />
  
  <!-- Final CTA Section -->
  <section class="py-24 premium-gradient relative overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-0 left-0 w-96 h-96 bg-primary rounded-full filter blur-3xl"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent rounded-full filter blur-3xl"></div>
    </div>
    
    <div class="container mx-auto px-6 text-center relative z-10">
      <h2 class="text-4xl md:text-6xl font-light text-foreground mb-6">
        Ready to Love Your
        <span class="font-serif italic text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent"> Lashes?</span>
      </h2>
      
      <p class="text-xl text-muted-foreground mb-12 max-w-2xl mx-auto">
        Join 100's of happy clients who wake up beautiful every day. 
        Book your appointment now and experience the Milka Collective difference.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="https://www.fresha.com/a/milka-collective-brighton-melbourne-229-bay-street-m4vife5o/all-offer?menu=true&pId=1089926"
          onclick="
            triggerConfettiFinalCTA();
            if (typeof window !== 'undefined' && window.dataLayer) {
              window.dataLayer.push({
                event: 'booking_click',
                click_type: 'final_cta',
                button_text: 'Book Your Appointment Now'
              });
            }
          "
          class="group relative px-8 py-4 bg-gradient-to-r from-pink-500 to-rose-400 text-white font-medium rounded-full overflow-hidden shadow-xl hover:shadow-2xl transition-all text-lg"
        >
          <span class="relative z-10">Book Your Appointment Now</span>
          <div class="absolute inset-0 bg-gradient-to-r from-rose-600 to-pink-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
        
        <a
          href="tel:0480095789"
          onclick="
            triggerConfettiFinalCTA();
            if (typeof window !== 'undefined' && window.dataLayer) {
              window.dataLayer.push({
                event: 'phone_click',
                click_type: 'final_cta',
                phone_number: '0480095789'
              });
            }
          "
          class="px-8 py-4 bg-white/80 backdrop-blur-sm text-gray-800 font-medium rounded-full shadow-lg border border-pink-100 hover:shadow-xl transition-all text-lg"
        >
          Or Call 0480 095 789
        </a>
      </div>
      
      <div class="mt-12 flex flex-wrap justify-center items-center gap-6 text-sm text-gray-600">
        <div class="flex items-center gap-2">
          <span class="text-lg">📍</span>
          <span>2/229 Bay St, Brighton</span>
        </div>
        <span class="text-pink-300">•</span>
        <div class="flex items-center gap-2">
          <span class="text-lg">⏰</span>
          <span>Mon-Thu 10am-8pm • Fri 10am-5pm • Sat 10am-4pm</span>
        </div>
        <span class="text-pink-300">•</span>
        <div class="flex items-center gap-2">
          <span class="text-lg">✨</span>
          <span>Over 95 5-Star Google Verified Reviews</span>
        </div>
      </div>
    </div>
  </section>
  
  <FloatingBookingButton client:load />
</LandingLayout>

<script>
  // Load canvas-confetti dynamically and create confetti function for final CTA
  let confettiLoaded = false;
  let confetti;

  async function loadConfetti() {
    if (!confettiLoaded) {
      const module = await import('canvas-confetti');
      confetti = module.default;
      confettiLoaded = true;
    }
    return confetti;
  }

  window.triggerConfettiFinalCTA = async function() {
    const confetti = await loadConfetti();
    
    // Create realistic confetti effect
    const count = 200;
    const defaults = {
      origin: { y: 0.7 }
    };

    function fire(particleRatio, opts) {
      confetti({
        ...defaults,
        ...opts,
        particleCount: Math.floor(count * particleRatio),
        colors: ['#fb7185', '#f43f5e', '#fda4af', '#fbbf24', '#a78bfa', '#34d399', '#ffffff']
      });
    }

    // Multiple bursts for realistic effect
    fire(0.25, {
      spread: 26,
      startVelocity: 55,
    });

    fire(0.2, {
      spread: 60,
    });

    fire(0.35, {
      spread: 100,
      decay: 0.91,
      scalar: 0.8
    });

    fire(0.1, {
      spread: 120,
      startVelocity: 25,
      decay: 0.92,
      scalar: 1.2
    });

    fire(0.1, {
      spread: 120,
      startVelocity: 45,
    });
  };
</script>